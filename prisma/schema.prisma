// Prisma Schema for Cyber Security Learning Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SCENARIO_BASED
}

enum SubmissionStatus {
  PENDING
  GRADED
  REJECTED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(STUDENT)
  status       UserStatus   @default(ACTIVE)
  avatar       String?
  bio          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions           Session[]
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  labProgress        LabProgress[]
  projectSubmissions ProjectSubmission[]
  certificates       Certificate[]
  userAchievements   UserAchievement[]
  bookmarks          Bookmark[]
  notes              Note[]
  learningActivities LearningActivity[]
  auditLogs          AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Level {
  id          String   @id @default(cuid())
  name        String   // Basic, Intermediate, Advanced
  slug        String   @unique
  description String
  order       Int      @default(1)
  badgeName   String?
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  levelId     String
  title       String
  slug        String   @unique
  description String
  icon        String?
  order       Int      @default(1)
  createdAt   DateTime @default(now())

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id                String   @id @default(cuid())
  courseId          String
  title             String
  slug              String   @unique
  level             String   // BASIC, INTERMEDIATE, ADVANCED
  description       String
  learningObjective String
  content           String   // Markdown / Rich theory & examples & security warnings
  labContent        String?  // Hands-on lab instructions & steps
  order             Int      @default(1)
  status            String   @default("PUBLISHED") // DRAFT, PUBLISHED
  durationMinutes   Int      @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz           Quiz?
  lab            Lab?
  lessonProgress LessonProgress[]
  bookmarks      Bookmark[]
  notes          Note[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  title        String
  passingScore Int      @default(70) // 70% passing requirement
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  question      String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  order         Int          @default(1)
  explanation   String
  correctAnswer String       // Stored securely on server, never returned in pre-submission quiz queries
  options       Json         // Array of { key: "A", text: "..." }
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int
  totalQuestions Int      @default(20)
  percentage     Int
  passed         Boolean
  userAnswers    Json     // Array of submitted answers
  reviewDetails  Json?    // Detailed breakdown returned post-submission
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Lab {
  id                  String   @id @default(cuid())
  lessonId            String?  @unique
  title               String
  slug                String   @unique
  objective           String
  environment         String   // e.g., "Local Docker / Juice Shop / Sandbox"
  prerequisites       String
  stepByStep          String   // Detailed markdown steps
  expectedResult      String
  securityExplanation String
  mitigation          String
  scenarioType        String   // "web", "network", "recon", "cryptography", "defensive"
  terminalCommands    Json?    // Simulated terminal commands & responses for interactive sandbox
  createdAt           DateTime @default(now())

  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  labProgress LabProgress[]
}

model LabProgress {
  id          String    @id @default(cuid())
  userId      String
  labId       String
  isCompleted Boolean   @default(false)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
}

model FinalProject {
  id           String   @id @default(cuid())
  title        String
  description  String
  scope        String
  instructions String
  rubric       Json     // Scoring breakdown (Scope: 10, Methodology: 15, etc.)
  passingScore Int      @default(70)
  createdAt    DateTime @default(now())

  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id              String           @id @default(cuid())
  userId          String
  projectId       String
  title           String
  description     String
  testingScope    String
  methodology     String
  findings        String
  recommendations String
  reportUrl       String?
  score           Int?
  scoreBreakdown  Json?            // Detailed breakdown across rubric categories
  feedback        String?
  status          SubmissionStatus @default(PENDING)
  gradedAt        DateTime?
  createdAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalProject FinalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  certificateNo    String   @unique // e.g. CSL-84920193
  programName      String   @default("Cyber Security Learning Program")
  level            String   @default("Basic → Intermediate → Advanced")
  issuedAt         DateTime @default(now())
  verificationCode String   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  icon        String
  criteria    String

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LearningActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String   // LESSON_COMPLETED, QUIZ_PASSED, LAB_COMPLETED, CERTIFICATE_EARNED
  details   String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // LOGIN, LOGOUT, CREATE_LESSON, UPDATE_LESSON, DELETE_LESSON, CREATE_QUIZ, UPDATE_QUIZ, DELETE_QUIZ, CHANGE_ROLE, ISSUE_CERTIFICATE
  resource   String
  resourceId String?
  metadata   Json?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
