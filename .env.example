# Neon PostgreSQL Database Connection URL
# e.g., postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secure Secret for Auth Session tokens (minimum 32 characters)
AUTH_SECRET="cyber-sec-learning-platform-secure-session-key-2026-supersecret"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Gemini API Key for AI Security Lab Assistant
GEMINI_API_KEY=
